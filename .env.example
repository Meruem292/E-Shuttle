# E-Shuttle Environment Configuration Template
# Copy this file to .env or .env.local and fill in your Firebase project credentials

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Firebase Client Configuration (From Firebase Console -> Project Settings -> General -> Your Apps -> Web App)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_APP_ID"
VITE_FIREBASE_DATABASE_ID="(default)"
