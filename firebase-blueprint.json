{
  "entities": {
    "users": {
      "fields": {
        "uid": { "type": "string", "description": "User UID" },
        "role": { "type": "string", "description": "Role: customer or admin" },
        "fullName": { "type": "string", "description": "Full Name" },
        "email": { "type": "string", "description": "Email address" },
        "phone": { "type": "string", "description": "Phone number" },
        "photoURL": { "type": "string", "description": "Avatar URL" },
        "accountStatus": { "type": "string", "description": "Account status" },
        "createdAt": { "type": "timestamp", "description": "Created time" },
        "updatedAt": { "type": "timestamp", "description": "Updated time" }
      }
    },
    "drivers": {
      "fields": {
        "uid": { "type": "string", "description": "Driver UID" },
        "role": { "type": "string", "description": "Role: driver" },
        "fullName": { "type": "string", "description": "Full Name" },
        "email": { "type": "string", "description": "Email" },
        "phone": { "type": "string", "description": "Phone number" },
        "photoURL": { "type": "string", "description": "Avatar URL" },
        "accountStatus": { "type": "string", "description": "PENDING, APPROVED, REJECTED, SUSPENDED" },
        "availability": { "type": "string", "description": "OFFLINE, ONLINE, BUSY" },
        "vehicleType": { "type": "string", "description": "e.g. E-Bike Shuttle" },
        "vehicleInfo": { "type": "string", "description": "Model and Plate/Serial" },
        "currentLocation": { "type": "map", "description": "lat, lng, address, updatedAt" },
        "activeBookingId": { "type": "string", "description": "Active booking ID if busy" },
        "rating": { "type": "number", "description": "Average rating" },
        "totalRides": { "type": "number", "description": "Total rides completed" },
        "createdAt": { "type": "timestamp", "description": "Created time" },
        "updatedAt": { "type": "timestamp", "description": "Updated time" }
      }
    },
    "bookings": {
      "fields": {
        "customerId": { "type": "string", "description": "Customer UID" },
        "customerName": { "type": "string", "description": "Customer Name" },
        "customerPhone": { "type": "string", "description": "Customer Phone" },
        "driverId": { "type": "string", "description": "Assigned Driver UID" },
        "driverName": { "type": "string", "description": "Driver Name" },
        "driverPhone": { "type": "string", "description": "Driver Phone" },
        "driverVehicleInfo": { "type": "string", "description": "Driver Vehicle info" },
        "status": { "type": "string", "description": "SEARCHING, DRIVER_ASSIGNED, DRIVER_ARRIVING, DRIVER_ARRIVED, RIDE_STARTED, COMPLETED, CANCELLED" },
        "pickup": { "type": "map", "description": "latitude, longitude, address" },
        "destination": { "type": "map", "description": "latitude, longitude, address" },
        "distanceKm": { "type": "number", "description": "Distance in Km" },
        "estimatedDurationMinutes": { "type": "number", "description": "Duration in mins" },
        "estimatedFare": { "type": "number", "description": "Fare in local currency PHP" },
        "createdAt": { "type": "timestamp", "description": "Booking creation time" },
        "acceptedAt": { "type": "timestamp", "description": "Accepted time" },
        "driverArrivedAt": { "type": "timestamp", "description": "Arrived time" },
        "startedAt": { "type": "timestamp", "description": "Start time" },
        "completedAt": { "type": "timestamp", "description": "Completion time" },
        "cancelledAt": { "type": "timestamp", "description": "Cancellation time" },
        "rating": { "type": "number", "description": "Rating given by customer" },
        "comment": { "type": "string", "description": "Feedback comment" }
      }
    },
    "rides": {
      "fields": {
        "bookingId": { "type": "string", "description": "Booking ID" },
        "customerId": { "type": "string", "description": "Customer UID" },
        "driverId": { "type": "string", "description": "Driver UID" },
        "pickup": { "type": "map", "description": "Pickup location" },
        "destination": { "type": "map", "description": "Destination location" },
        "distanceKm": { "type": "number", "description": "Distance" },
        "durationMinutes": { "type": "number", "description": "Duration" },
        "fare": { "type": "number", "description": "Fare" },
        "startedAt": { "type": "timestamp", "description": "Start timestamp" },
        "completedAt": { "type": "timestamp", "description": "Completed timestamp" },
        "createdAt": { "type": "timestamp", "description": "Record timestamp" }
      }
    },
    "ratings": {
      "fields": {
        "bookingId": { "type": "string", "description": "Booking ID" },
        "customerId": { "type": "string", "description": "Customer UID" },
        "driverId": { "type": "string", "description": "Driver UID" },
        "rating": { "type": "number", "description": "1 to 5 stars" },
        "comment": { "type": "string", "description": "Feedback text" },
        "createdAt": { "type": "timestamp", "description": "Created time" }
      }
    },
    "adminSettings": {
      "fields": {
        "baseFare": { "type": "number", "description": "Base fare" },
        "pricePerKm": { "type": "number", "description": "Price per kilometer" },
        "minimumFare": { "type": "number", "description": "Minimum fare" },
        "initialSearchRadiusKm": { "type": "number", "description": "Search radius in Km" },
        "updatedAt": { "type": "timestamp", "description": "Updated timestamp" }
      }
    },
    "shuttleStations": {
      "fields": {
        "name": { "type": "string", "description": "Station Name" },
        "address": { "type": "string", "description": "Station Address" },
        "latitude": { "type": "number", "description": "Latitude" },
        "longitude": { "type": "number", "description": "Longitude" },
        "radiusMeters": { "type": "number", "description": "Proximity radius in meters" },
        "isActive": { "type": "boolean", "description": "Active status" },
        "category": { "type": "string", "description": "Station category" },
        "description": { "type": "string", "description": "Additional station notes" },
        "createdAt": { "type": "timestamp", "description": "Created time" },
        "updatedAt": { "type": "timestamp", "description": "Updated time" }
      }
    },
    "activityLogs": {
      "fields": {
        "action": { "type": "string", "description": "CREATE, UPDATE, DELETE, AUTH_LOGIN, etc." },
        "actionLabel": { "type": "string", "description": "Readable action title" },
        "entityType": { "type": "string", "description": "STATION, ZONE, SHUTTLE, RIDE, USER, etc." },
        "entityId": { "type": "string", "description": "Target entity ID" },
        "entityName": { "type": "string", "description": "Target entity label" },
        "summary": { "type": "string", "description": "Brief log summary" },
        "details": { "type": "map", "description": "Before/after values or metadata" },
        "performedBy": { "type": "map", "description": "Actor uid, name, email, role" },
        "timestamp": { "type": "string", "description": "ISO timestamp string" },
        "severity": { "type": "string", "description": "info, success, warning, danger" },
        "createdAt": { "type": "timestamp", "description": "Server timestamp" }
      }
    },
    "incidentTickets": {
      "fields": {
        "ticketNumber": { "type": "string", "description": "Formatted ticket number" },
        "category": { "type": "string", "description": "Incident category" },
        "subject": { "type": "string", "description": "Ticket subject" },
        "description": { "type": "string", "description": "Details of incident" },
        "priority": { "type": "string", "description": "low, medium, high, emergency" },
        "status": { "type": "string", "description": "open, in_progress, resolved, closed" },
        "reporterId": { "type": "string", "description": "Reporter UID" },
        "reporterName": { "type": "string", "description": "Reporter Name" },
        "reporterRole": { "type": "string", "description": "customer, driver, admin" },
        "channelId": { "type": "string", "description": "Associated chat channel ID" },
        "createdAt": { "type": "timestamp", "description": "Creation timestamp" },
        "updatedAt": { "type": "timestamp", "description": "Last updated timestamp" }
      }
    },
    "chatChannels": {
      "fields": {
        "title": { "type": "string", "description": "Channel display title" },
        "subtitle": { "type": "string", "description": "Channel subtitle" },
        "type": { "type": "string", "description": "ride, support, direct" },
        "participants": { "type": "array", "description": "Participant details" },
        "lastMessage": { "type": "string", "description": "Preview of last message" },
        "lastMessageSender": { "type": "string", "description": "Sender of last message" },
        "createdAt": { "type": "timestamp", "description": "Creation timestamp" },
        "updatedAt": { "type": "timestamp", "description": "Last updated timestamp" }
      }
    },
    "zones": {
      "fields": {
        "name": { "type": "string", "description": "Geofence zone name" },
        "description": { "type": "string", "description": "Zone description" },
        "color": { "type": "string", "description": "Zone border color" },
        "fillColor": { "type": "string", "description": "Zone fill color" },
        "fillOpacity": { "type": "number", "description": "Fill opacity" },
        "polygon": { "type": "array", "description": "Array of lat/lng coordinate pairs" },
        "status": { "type": "string", "description": "active, inactive, restricted" },
        "maxSpeedKmH": { "type": "number", "description": "Zone speed limit" },
        "createdAt": { "type": "timestamp", "description": "Creation timestamp" },
        "updatedAt": { "type": "timestamp", "description": "Last update timestamp" }
      }
    },
    "ebikes": {
      "fields": {
        "code": { "type": "string", "description": "Unique e-bike asset code" },
        "plateNumber": { "type": "string", "description": "Plate number" },
        "model": { "type": "string", "description": "E-bike model" },
        "status": { "type": "string", "description": "AVAILABLE, ON_TRIP, MAINTENANCE, OFFLINE" },
        "assignedDriverId": { "type": "string", "description": "Driver UID if assigned" },
        "currentLocation": { "type": "map", "description": "lat, lng, address" },
        "lastRfidCardUid": { "type": "string", "description": "Last physical RFID card UID tapped" },
        "createdAt": { "type": "timestamp", "description": "Creation timestamp" },
        "updatedAt": { "type": "timestamp", "description": "Last update timestamp" }
      }
    }
  }
}
