{
  "entities": {
    "users": {
      "fields": {
        "uid": { "type": "string", "description": "User UID" },
        "role": { "type": "string", "description": "Role: customer or admin" },
        "fullName": { "type": "string", "description": "Full Name" },
        "email": { "type": "string", "description": "Email address" },
        "phone": { "type": "string", "description": "Phone number" },
        "photoURL": { "type": "string", "description": "Avatar URL" },
        "accountStatus": { "type": "string", "description": "Account status" },
        "createdAt": { "type": "timestamp", "description": "Created time" },
        "updatedAt": { "type": "timestamp", "description": "Updated time" }
      }
    },
    "drivers": {
      "fields": {
        "uid": { "type": "string", "description": "Driver UID" },
        "role": { "type": "string", "description": "Role: driver" },
        "fullName": { "type": "string", "description": "Full Name" },
        "email": { "type": "string", "description": "Email" },
        "phone": { "type": "string", "description": "Phone number" },
        "photoURL": { "type": "string", "description": "Avatar URL" },
        "accountStatus": { "type": "string", "description": "PENDING, APPROVED, REJECTED, SUSPENDED" },
        "availability": { "type": "string", "description": "OFFLINE, ONLINE, BUSY" },
        "vehicleType": { "type": "string", "description": "e.g. E-Bike Shuttle" },
        "vehicleInfo": { "type": "string", "description": "Model and Plate/Serial" },
        "currentLocation": { "type": "map", "description": "lat, lng, address, updatedAt" },
        "activeBookingId": { "type": "string", "description": "Active booking ID if busy" },
        "rating": { "type": "number", "description": "Average rating" },
        "totalRides": { "type": "number", "description": "Total rides completed" },
        "createdAt": { "type": "timestamp", "description": "Created time" },
        "updatedAt": { "type": "timestamp", "description": "Updated time" }
      }
    },
    "bookings": {
      "fields": {
        "customerId": { "type": "string", "description": "Customer UID" },
        "customerName": { "type": "string", "description": "Customer Name" },
        "customerPhone": { "type": "string", "description": "Customer Phone" },
        "driverId": { "type": "string", "description": "Assigned Driver UID" },
        "driverName": { "type": "string", "description": "Driver Name" },
        "driverPhone": { "type": "string", "description": "Driver Phone" },
        "driverVehicleInfo": { "type": "string", "description": "Driver Vehicle info" },
